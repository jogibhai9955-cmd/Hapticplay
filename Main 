ame: Build APK

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Create Capacitor Android project
        run: |
          mkdir -p www && cp index.html www/index.html
          [ -f package.json ] || npm init -y
          npm install @capacitor/core@6 @capacitor/cli@6 @capacitor/android@6
          cat > capacitor.config.json <<'EOF'
          {
            "appId": "com.haptic.player",
            "appName": "Haptic Player",
            "webDir": "www",
            "backgroundColor": "#000000"
          }
          EOF
          rm -rf android
          npx cap add android

      - name: Add native music code
        run: |
          PKG=android/app/src/main/java/com/haptic/player
          mkdir -p $PKG android/app/src/main/res/drawable
          cat > $PKG/HapticPlugin.java <<'EOF'
          package com.haptic.player;

          import android.Manifest;
          import android.content.ContentUris;
          import android.content.Context;
          import android.content.Intent;
          import android.database.Cursor;
          import android.graphics.Bitmap;
          import android.graphics.BitmapFactory;
          import android.media.MediaMetadataRetriever;
          import android.net.Uri;
          import android.os.Build;
          import android.provider.MediaStore;
          import android.util.Base64;
          import android.util.Size;
          import com.getcapacitor.JSArray;
          import com.getcapacitor.JSObject;
          import com.getcapacitor.PermissionState;
          import com.getcapacitor.Plugin;
          import com.getcapacitor.PluginCall;
          import com.getcapacitor.PluginMethod;
          import com.getcapacitor.annotation.CapacitorPlugin;
          import com.getcapacitor.annotation.Permission;
          import com.getcapacitor.annotation.PermissionCallback;
          import java.io.ByteArrayOutputStream;

          @CapacitorPlugin(
            name = "Haptic",
            permissions = {
              @Permission(strings = {"android.permission.READ_MEDIA_AUDIO"}, alias = "audio33"),
              @Permission(strings = {Manifest.permission.READ_EXTERNAL_STORAGE}, alias = "audioOld"),
              @Permission(strings = {"android.permission.POST_NOTIFICATIONS"}, alias = "notif")
            }
          )
          public class HapticPlugin extends Plugin {
            static HapticPlugin instance;

            @Override
            public void load() {
              instance = this;
              try {
                getActivity().runOnUiThread(new Runnable() {
                  public void run() {
                    getBridge().getWebView().getSettings().setMediaPlaybackRequiresUserGesture(false);
                  }
                });
              } catch (Exception e) { }
            }

            private String audioAlias() {
              return Build.VERSION.SDK_INT >= 33 ? "audio33" : "audioOld";
            }

            @PluginMethod
            public void scan(PluginCall call) {
              if (getPermissionState(audioAlias()) != PermissionState.GRANTED) {
                requestPermissionForAlias(audioAlias(), call, "scanPerm");
              } else {
                doScan(call);
              }
            }

            @PermissionCallback
            private void scanPerm(PluginCall call) {
              if (getPermissionState(audioAlias()) == PermissionState.GRANTED) {
                doScan(call);
              } else {
                call.reject("denied");
              }
            }

            @PluginMethod
            public void askNotif(PluginCall call) {
              if (Build.VERSION.SDK_INT >= 33 && getPermissionState("notif") != PermissionState.GRANTED) {
                requestPermissionForAlias("notif", call, "notifCb");
              } else {
                call.resolve();
              }
            }

            @PermissionCallback
            private void notifCb(PluginCall call) {
              call.resolve();
            }

            private void doScan(final PluginCall call) {
              final int minMs = call.getData().optInt("minDuration", 30000);
              new Thread(new Runnable() {
                public void run() {
                  JSArray arr = new JSArray();
                  Cursor c = null;
                  try {
                    Uri base = MediaStore.Audio.Media.EXTERNAL_CONTENT_URI;
                    String[] proj = new String[] {
                      MediaStore.Audio.Media._ID,
                      MediaStore.Audio.Media.TITLE,
                      MediaStore.Audio.Media.ARTIST,
                      MediaStore.Audio.Media.ALBUM,
                      MediaStore.Audio.Media.DURATION,
                      MediaStore.Audio.Media.DATE_ADDED
                    };
                    String sel = MediaStore.Audio.Media.IS_RINGTONE + "=0 AND " + MediaStore.Audio.Media.IS_NOTIFICATION + "=0 AND " + MediaStore.Audio.Media.IS_ALARM + "=0 AND " + MediaStore.Audio.Media.DURATION + ">=" + minMs;
                    c = getContext().getContentResolver().query(base, proj, sel, null, MediaStore.Audio.Media.TITLE + " COLLATE NOCASE ASC");
                    if (c != null) {
                      while (c.moveToNext()) {
                        long id = c.getLong(0);
                        JSObject o = new JSObject();
                        o.put("id", id);
                        o.put("title", c.getString(1));
                        o.put("artist", c.getString(2));
                        o.put("album", c.getString(3));
                        o.put("duration", c.getLong(4));
                        o.put("added", c.getLong(5));
                        o.put("uri", ContentUris.withAppendedId(base, id).toString());
                        arr.put(o);
                      }
                    }
                  } catch (Exception e) {
                    call.reject("scan failed: " + e.getMessage());
                    return;
                  } finally {
                    if (c != null) c.close();
                  }
                  JSObject r = new JSObject();
                  r.put("tracks", arr);
                  call.resolve(r);
                }
              }).start();
            }

            static Bitmap loadArt(Context ctx, long id, int size) {
              Uri uri = ContentUris.withAppendedId(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, id);
              Bitmap bm = null;
              if (Build.VERSION.SDK_INT >= 29) {
                try {
                  bm = ctx.getContentResolver().loadThumbnail(uri, new Size(size, size), null);
                } catch (Exception e) { }
              }
              if (bm == null) {
                try {
                  MediaMetadataRetriever m = new MediaMetadataRetriever();
                  m.setDataSource(ctx, uri);
                  byte[] b = m.getEmbeddedPicture();
                  m.release();
                  if (b != null) {
                    BitmapFactory.Options opt = new BitmapFactory.Options();
                    opt.inSampleSize = 2;
                    bm = BitmapFactory.decodeByteArray(b, 0, b.length, opt);
                  }
                } catch (Exception e) { }
              }
              return bm;
            }

            @PluginMethod
            public void art(final PluginCall call) {
              final long id = call.getData().optLong("id", -1);
              final int size = call.getData().optInt("size", 300);
              new Thread(new Runnable() {
                public void run() {
                  JSObject r = new JSObject();
                  try {
                    Bitmap bm = loadArt(getContext(), id, size);
                    if (bm != null) {
                      ByteArrayOutputStream o = new ByteArrayOutputStream();
                      bm.compress(Bitmap.CompressFormat.JPEG, 85, o);
                      r.put("data", Base64.encodeToString(o.toByteArray(), Base64.NO_WRAP));
                    }
                  } catch (Exception e) { }
                  call.resolve(r);
                }
              }).start();
            }

            @PluginMethod
            public void session(PluginCall call) {
              JSObject d = call.getData();
              boolean playing = d.optBoolean("playing", false);
              Context ctx = getContext();
              if (!PlayerService.running && !playing) {
                call.resolve();
                return;
              }
              Intent i = new Intent(ctx, PlayerService.class);
              i.setAction(PlayerService.ACT_UPDATE);
              i.putExtra("title", d.optString("title", ""));
              i.putExtra("artist", d.optString("artist", ""));
              i.putExtra("album", d.optString("album", ""));
              i.putExtra("id", d.optLong("id", -1));
              i.putExtra("duration", d.optLong("duration", 0));
              i.putExtra("position", d.optLong("position", 0));
              i.putExtra("rate", (float) d.optDouble("rate", 1.0));
              i.putExtra("playing", playing);
              try {
                if (Build.VERSION.SDK_INT >= 26 && !PlayerService.running) {
                  ctx.startForegroundService(i);
                } else {
                  ctx.startService(i);
                }
              } catch (Exception e) { }
              call.resolve();
            }

            @PluginMethod
            public void stop(PluginCall call) {
              try {
                getContext().stopService(new Intent(getContext(), PlayerService.class));
              } catch (Exception e) { }
              call.resolve();
            }

            static void emit(String action, long pos) {
              if (instance == null) return;
              JSObject o = new JSObject();
              o.put("action", action);
              o.put("position", pos);
              instance.notifyListeners("action", o);
            }
          }
          EOF
          cat > $PKG/PlayerService.java <<'EOF'
          package com.haptic.player;

          import android.app.Notification;
          import android.app.NotificationChannel;
          import android.app.NotificationManager;
          import android.app.PendingIntent;
          import android.app.Service;
          import android.content.Context;
          import android.content.Intent;
          import android.content.pm.ServiceInfo;
          import android.graphics.Bitmap;
          import android.media.MediaMetadata;
          import android.media.session.MediaSession;
          import android.media.session.PlaybackState;
          import android.os.Build;
          import android.os.Handler;
          import android.os.IBinder;
          import android.os.Looper;
          import android.os.PowerManager;
          import android.os.SystemClock;

          public class PlayerService extends Service {
            static final String CH = "haptic_playback";
            static final int NID = 4711;
            static final String ACT_UPDATE = "com.haptic.player.UPDATE";
            static final String ACT_TOGGLE = "com.haptic.player.TOGGLE";
            static final String ACT_NEXT = "com.haptic.player.NEXT";
            static final String ACT_PREV = "com.haptic.player.PREV";
            static final String ACT_DISMISS = "com.haptic.player.DISMISS";
            static boolean running = false;

            private MediaSession session;
            private PowerManager.WakeLock wl;
            private NotificationManager nm;
            private final Handler handler = new Handler(Looper.getMainLooper());
            private String title = "", artist = "", album = "";
            private long id = -1, artId = -2, duration = 0, position = 0;
            private float rate = 1f;
            private boolean playing = false, fg = false;
            private Bitmap art = null;

            @Override
            public void onCreate() {
              super.onCreate();
              running = true;
              nm = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
              if (Build.VERSION.SDK_INT >= 26) {
                NotificationChannel ch = new NotificationChannel(CH, "Music playback", NotificationManager.IMPORTANCE_LOW);
                ch.setShowBadge(false);
                ch.setLockscreenVisibility(Notification.VISIBILITY_PUBLIC);
                nm.createNotificationChannel(ch);
              }
              session = new MediaSession(this, "HapticPlayer");
              session.setFlags(MediaSession.FLAG_HANDLES_MEDIA_BUTTONS | MediaSession.FLAG_HANDLES_TRANSPORT_CONTROLS);
              session.setCallback(new MediaSession.Callback() {
                @Override public void onPlay() { req(true); }
                @Override public void onPause() { req(false); }
                @Override public void onStop() { req(false); }
                @Override public void onSkipToNext() { HapticPlugin.emit("next", 0); }
                @Override public void onSkipToPrevious() { HapticPlugin.emit("prev", 0); }
                @Override public void onSeekTo(long pos) { HapticPlugin.emit("seek", pos); }
              });
              session.setActive(true);
            }

            @Override
            public int onStartCommand(Intent i, int flags, int startId) {
              String a = i == null ? null : i.getAction();
              if (a == null) {
                if (!fg) stopSelf();
                return START_NOT_STICKY;
              }
              if (ACT_TOGGLE.equals(a)) {
                req(!playing);
              } else if (ACT_NEXT.equals(a)) {
                HapticPlugin.emit("next", 0);
              } else if (ACT_PREV.equals(a)) {
                HapticPlugin.emit("prev", 0);
              } else if (ACT_DISMISS.equals(a)) {
                stopSelf();
              } else if (ACT_UPDATE.equals(a)) {
                title = i.getStringExtra("title");
                artist = i.getStringExtra("artist");
                album = i.getStringExtra("album");
                duration = i.getLongExtra("duration", 0);
                position = i.getLongExtra("position", 0);
                rate = i.getFloatExtra("rate", 1f);
                playing = i.getBooleanExtra("playing", false);
                final long nid = i.getLongExtra("id", -1);
                if (nid != artId) {
                  artId = nid;
                  art = null;
                  if (nid >= 0) {
                    new Thread(new Runnable() {
                      public void run() {
                        final Bitmap b = HapticPlugin.loadArt(PlayerService.this, nid, 512);
                        handler.post(new Runnable() {
                          public void run() {
                            if (b != null && nid == artId) {
                              art = b;
                              refresh();
                            }
                          }
                        });
                      }
                    }).start();
                  }
                }
                refresh();
              }
              return START_NOT_STICKY;
            }

            private void req(boolean want) {
              playing = want;
              try { if (title != null) refresh(); } catch (Exception e) { }
              HapticPlugin.emit(want ? "play" : "pause", 0);
            }

            private void refresh() {
              try {
                MediaMetadata.Builder m = new MediaMetadata.Builder()
                  .putString(MediaMetadata.METADATA_KEY_TITLE, title)
                  .putString(MediaMetadata.METADATA_KEY_ARTIST, artist)
                  .putString(MediaMetadata.METADATA_KEY_ALBUM, album)
                  .putLong(MediaMetadata.METADATA_KEY_DURATION, duration);
                if (art != null) m.putBitmap(MediaMetadata.METADATA_KEY_ALBUM_ART, art);
                session.setMetadata(m.build());
                long actions = PlaybackState.ACTION_PLAY | PlaybackState.ACTION_PAUSE | PlaybackState.ACTION_PLAY_PAUSE
                  | PlaybackState.ACTION_SKIP_TO_NEXT | PlaybackState.ACTION_SKIP_TO_PREVIOUS
                  | PlaybackState.ACTION_SEEK_TO | PlaybackState.ACTION_STOP;
                PlaybackState ps = new PlaybackState.Builder()
                  .setActions(actions)
                  .setState(playing ? PlaybackState.STATE_PLAYING : PlaybackState.STATE_PAUSED, position, playing ? rate : 0f, SystemClock.elapsedRealtime())
                  .build();
                session.setPlaybackState(ps);
              } catch (Exception e) { }

              Notification n = buildNotification();
              handler.removeCallbacks(detach);
              if (playing) {
                try {
                  if (Build.VERSION.SDK_INT >= 29) {
                    startForeground(NID, n, ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PLAYBACK);
                  } else {
                    startForeground(NID, n);
                  }
                  fg = true;
                } catch (Exception e) {
                  nm.notify(NID, n);
                }
                lock(true);
              } else {
                nm.notify(NID, n);
                handler.postDelayed(detach, 4000);
              }
            }

            private final Runnable detach = new Runnable() {
              public void run() {
                if (playing) return;
                if (fg) {
                  if (Build.VERSION.SDK_INT >= 24) stopForeground(Service.STOP_FOREGROUND_DETACH);
                  else stopForeground(false);
                  fg = false;
                  try { nm.notify(NID, buildNotification()); } catch (Exception e) { }
                }
                lock(false);
              }
            };

            private void lock(boolean on) {
              try {
                if (on) {
                  if (wl == null) {
                    PowerManager pm = (PowerManager) getSystemService(Context.POWER_SERVICE);
                    wl = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "haptic:playback");
                    wl.setReferenceCounted(false);
                  }
                  if (!wl.isHeld()) wl.acquire(6 * 60 * 60 * 1000L);
                } else if (wl != null && wl.isHeld()) {
                  wl.release();
                }
              } catch (Exception e) { }
            }

            private PendingIntent svc(String action, int code) {
              Intent i = new Intent(this, PlayerService.class);
              i.setAction(action);
              int fl = PendingIntent.FLAG_UPDATE_CURRENT;
              if (Build.VERSION.SDK_INT >= 23) fl |= PendingIntent.FLAG_IMMUTABLE;
              return PendingIntent.getService(this, code, i, fl);
            }

            @SuppressWarnings("deprecation")
            private Notification buildNotification() {
              Notification.Builder b = Build.VERSION.SDK_INT >= 26 ? new Notification.Builder(this, CH) : new Notification.Builder(this);
              int small = getResources().getIdentifier("ic_stat_music", "drawable", getPackageName());
              if (small == 0) small = android.R.drawable.ic_media_play;
              b.setSmallIcon(small)
                .setContentTitle(title)
                .setContentText(artist)
                .setSubText(album)
                .setShowWhen(false)
                .setOnlyAlertOnce(true)
                .setOngoing(playing)
                .setVisibility(Notification.VISIBILITY_PUBLIC)
                .setDeleteIntent(svc(ACT_DISMISS, 5));
              if (Build.VERSION.SDK_INT < 26) b.setPriority(Notification.PRIORITY_LOW);
              Intent 